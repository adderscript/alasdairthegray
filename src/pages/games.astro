---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import games from '../content/games.json'
---

<Layout>
    <a href="/"><h1 class="mt-10 mb-5">Very Cool Games</h1></a>

    <div class="wm-max text-left">
        {games.map(game => (
            <GameCard title={game.title} description={game.description} gamePage={game.url} />
        ))}
    </div>
</Layout>
