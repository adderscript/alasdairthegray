---
import Layout from '../../layouts/Layout.astro';
import GameControls from '../../components/GameControls.astro';
import games from '../../content/games.json';

export function getStaticPaths() {
    return games.map((game) => ({
        params: { slug: game.gamePage.split('/').pop() },
        props: { game }
    }));
}

const { game } = Astro.props;
---

<Layout>
    <div class="-mt-10 w-full max-w-[1600px] mx-auto px-5 py-10">
        <a href="/">
            <h1 class="mb-6 mt-2">{game.title}</h1>
        </a>
        

        <div class="game-layout">
            <!-- Game Container -->
            <div class="game-container-wrapper overflow-hidden">
                <div id="game-container" class="relative border-2 border-accent">
                    <iframe
                        id="game-iframe"
                        src={game.gameUrl}
                        title={game.title}
                        allowfullscreen
                        allow="gamepad; microphone; camera"
                        class="w-full h-full border-none"
                    ></iframe>

                    <div class="absolute inset-0 z-10 pointer-events-none">
                        <a
                            href={game.gameUrl}
                            class="pointer-events-auto absolute top-2 left-2 px-3 py-2 text-text text-xl"
                        >
                            fullscreen
                        </a>
                    </div>  
                </div>
            </div>

            <!-- Controls Sidebar -->
            <div class="controls-sidebar">
                <GameControls controls={game.controls} />
            </div>
        </div>
    </div>
</Layout>

<style>
    /* Game Layout */
    .game-layout {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        align-items: center;
        justify-content: center;
        width: 100%;
    }

    .game-container-wrapper {
        width: 100%;
    }

    #game-container {
        position: relative;
        width: 100%;
        padding-bottom: 56.25%; /* 16:9 aspect ratio (9/16 = 0.5625) */
        height: 0;
    }

    #game-container iframe {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1;
    }   

    @media (min-width: 1024px) {
        .game-layout {
            flex-direction: row;
        }

        .game-container-wrapper {
            width: 60vw;
            flex-shrink: 0;
        }

        .controls-sidebar {
            width: 320px;
            flex-shrink: 0;
        }
    }
</style>