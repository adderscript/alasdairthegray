---
import Layout from '../../layouts/Layout.astro';
import GameCard from '../../components/GameCard.astro';
import games from '../../content/games.json'
---

<Layout>
    <div class="text-left">
        {games.map(game => (
            <GameCard title={game.title} description={game.description} gamePage={game.gamePage} />
        ))}
    </div>
</Layout>