---
import Header from '../components/Header.astro';
import PageLink from '../components/PageLink.astro';
import SocialsButton from '../components/SocialsButton.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
    <Header />
	<div class="flex items-center border-surface">
		<PageLink name="Games" link="/games" />
		<img src="/wizard.png" alt="wizard" class="w-85 h-85 [image-rendering:pixelated]" />
	</div>
	<div class="flex items-center border-surface">
		<img src="/little-gremlin.png" alt="wizard" class="w-85 h-85 [image-rendering:pixelated]" />
		<PageLink name="Tutorials" link="/tutorials" />
	</div>	

	<!-- socials -->
	<div class="m-3 mt-10 mb-20 flex flex-wrap gap-6 justify-center">
		<SocialsButton name="GITHUB" link="https://github.com/adderscript" />
		<SocialsButton name="EMAIL" link="mailto:alasdair@adderscript.net" />
		<SocialsButton name="BUY ME A COFFEE" link="https://buymeacoffee.com/AdderScript" />
	</div>
</Layout>
