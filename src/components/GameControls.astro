---
interface Control {
    keys: string[];
    description: string;
}

interface Props {
    controls: Control[];
}

const { controls } = Astro.props;
---

<div class="bg-game-card-background p-6 border-l-4 border-surface">
    <h2 class="text-xl mb-4">Controls</h2>
    <div class="space-y-3">
        {controls.map((control) => (
            <div class="flex flex-col gap-2">
                <div class="flex gap-2 flex-wrap">
                    {control.keys.map((key) => (
                        <kbd class="px-3 py-1.5 border-l-3 border-t-3 border-accent text-sm text-text-secondary font-bold">
                            {key}
                        </kbd>
                    ))}
                </div>
                <span class="text-text text-sm">{control.description}</span>
            </div>
        ))}
    </div>
</div>
